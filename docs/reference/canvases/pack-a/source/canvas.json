"notes": {
"t_map": {
"x": 0,
"y": -300,
"text": "Resolve 2 intake: how the screens lead on",
"kind": "title1",
"maxW": 2560,
"page": "flow"
},
"n02c": {
"x": 9520,
"y": 2440,
"w": 1280,
"text": "02c is 02b with the pull-in panel open. Copy the prompt, paste the other AI's answer in the box, Continue.",
"page": "flow",
"fill": "orange"
},
"t_rowA": {
"x": 0,
"y": 1300,
"text": "Screens 01 to 05: from your name to what Resolve understood",
"kind": "title1",
"maxW": 10800,
"page": "flow"
},
"t_rowB": {
"x": 0,
"y": 2900,
"text": "Screens 06 to 12: from your first move to Open my project",
"kind": "title1",
"maxW": 9440,
"page": "flow"
},
"n01": {
"x": 0,
"y": 2440,
"w": 1280,
"text": "Leads to 02a. Enter or Continue. Continue stays off until you type a name. The field has focus on arrival.",
"page": "flow",
"fill": "orange"
},
"n02a": {
"x": 1360,
"y": 2440,
"w": 1280,
"text": "Leads to 02b. Pick one of the three. 'Hi Simeon.' plays once (M01), then the three paths rise in.",
"page": "flow",
"fill": "orange"
},
"n02b": {
"x": 2720,
"y": 2440,
"w": 1280,
"text": "Leads to 03. Continue (or Enter). 'Use a template' adds 8 headings; 'Try an example' fills them. The pull-in link opens 02c (far right of this row). Parked: an AI setup screen sits before this one when no AI is connected.",
"page": "flow",
"fill": "orange"
},
"n03": {
"x": 4080,
"y": 2440,
"w": 1280,
"text": "Next or 'Skip this question': the next question (M04). 'Skip the rest and see my proposal', or Resolve says it has enough: leads to 04. A wait over 15 s hands off to a fixed question (ST2). Every heard line is editable.",
"page": "flow",
"fill": "orange"
},
"n04": {
"x": 5440,
"y": 2440,
"w": 1280,
"text": "'This looks right' leads to 06, or to 05 when no outcome is found. 'Something's wrong' leads to 04b.",
"page": "flow",
"fill": "orange"
},
"n04b": {
"x": 6800,
"y": 2440,
"w": 1280,
"text": "'Save and continue' leads to 06 (or 05). Editing the outcome counts as confirming it. Cards grow as you type.",
"page": "flow",
"fill": "orange"
},
"n05": {
"x": 8160,
"y": 2440,
"w": 1280,
"text": "Branch. Fires only when Resolve finds no outcome. Your answer re-runs the check. Pass leads to 06. Not enough: the same screen asks once more.",
"page": "flow",
"fill": "red"
},
"n06": {
"x": 0,
"y": 4040,
"w": 1280,
"text": "Leads to 07. Continue. 'Skip to the whole picture' jumps to 09; Back still works.",
"page": "flow",
"fill": "orange"
},
"n07": {
"x": 1360,
"y": 4040,
"w": 1280,
"text": "One theme at a time. Yes adds it to the list on the right. Not quite opens a field: rewrite it, or 'Leave it off the roadmap' (goes to the cut list). After the last theme leads to 08.",
"page": "flow",
"fill": "orange"
},
"n08": {
"x": 2720,
"y": 4040,
"w": 1280,
"text": "Leads to 09. 'See it as a roadmap'.",
"page": "flow",
"fill": "orange"
},
"n09": {
"x": 4080,
"y": 4040,
"w": 1280,
"text": "Adopt leads to 10. Adopt writes the project and you can undo it. 'Edit the full proposal' opens the existing editor (Pack C); its 'Back to the summary' returns here.",
"page": "flow",
"fill": "orange"
},
"n10": {
"x": 5440,
"y": 4040,
"w": 1280,
"text": "Plays while the project is written. Ends only when the build is done, never on a timer alone. Leads to 11. Build fails: error on dark with Try again (ST4 rules).",
"page": "flow",
"fill": "orange"
},
"n11": {
"x": 6800,
"y": 4040,
"w": 1280,
"text": "Dark to light (M09). 'Open my project' leads to the app shell (Pack D).",
"page": "flow",
"fill": "orange"
},
"n12": {
"x": 8160,
"y": 4040,
"w": 1280,
"text": "Branch. Can appear at 03, 04, 06 or 10 when the AI budget or the provider's limit is hit. 'Continue without AI' stays on the same step with the manual path.",
"page": "flow",
"fill": "red"
},
